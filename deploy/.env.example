# Copy to deploy/.env on the server (never commit deploy/.env).
POSTGRES_PASSWORD=change-me
# Reading services for documents, tried in order (each only when its key is set).
JETSTREAM_API_KEY=
GROQ_API_KEY=
READER_PROVIDERS=jetstream,groq
# local = every document is read on this server by text recognition, nothing goes to an AI service (public site);
# examples = only the synthetic examples are read by an AI service, people type the rest;
# on = any document by the AI services (local testing only); off = no reading.
READ_MODE=local
# A domain pointing at the server, e.g. cleartab.example.org; ":80" serves plain HTTP for a first test.
SITE_ADDRESS=:80
READ_LIMIT_PER_HOUR=6
READ_LIMIT_PER_DAY=15
READ_LIMIT_GLOBAL_DAY=150
