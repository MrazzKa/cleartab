# ClearTab API: FastAPI + rule engine. Reference tables (CMS MUE/PTP) are mounted at run time, never baked in.
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
WORKDIR /app
COPY requirements.txt .
RUN pip install --no-cache-dir -r requirements.txt
COPY pipeline/ pipeline/
COPY billcheck/ billcheck/
COPY api/ api/
COPY data/processed/ data/processed/
# Bake the text recognition models into the image (about 50 MB) so reading works without network at run time.
RUN python -c "from billcheck.local_reader import _engine; _engine()"
RUN useradd --create-home app && mkdir -p data/raw && chown -R app /app/data/raw
USER app
EXPOSE 8000
CMD ["uvicorn", "api.main:app", "--host", "0.0.0.0", "--port", "8000", "--workers", "2", \
     "--proxy-headers", "--forwarded-allow-ips", "*", "--no-access-log"]
